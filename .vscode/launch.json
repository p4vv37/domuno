{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Router: wybierz scenariusz",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/debug_router.py",
      "args": [
        "${input:routerScenario}"
      ],
      "console": "integratedTerminal",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "name": "HA loop: full simulated pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/simulate_ha_loop.py",
      "args": [
        "${input:haScenario}",
        "--step"
      ],
      "console": "integratedTerminal",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "inputs": [
    {
      "id": "routerScenario",
      "type": "pickString",
      "description": "Router debug scenario",
      "options": [
        {
          "label": "toolcall — exact light in an exact area → TOOLCALL",
          "value": "toolcall"
        },
        {
          "label": "outside-grammar — two actions in one sentence → PASS",
          "value": "outside-grammar"
        },
        {
          "label": "negation — explicit negation → CLARIFY",
          "value": "negation"
        },
        {
          "label": "ambiguous — same name in two areas → CLARIFY",
          "value": "ambiguous"
        },
        {
          "label": "no-target — unknown device → PASS",
          "value": "no-target"
        },
        {
          "label": "closest-match — larger STT name/area typo → TOOLCALL",
          "value": "closest-match"
        },
        {
          "label": "prefix — unknown leading phrase before the verb → TOOLCALL",
          "value": "prefix"
        },
        {
          "label": "blocked-prefix — condition/question prefix → PASS",
          "value": "blocked-prefix"
        },
        {
          "label": "position — absolute cover position → TOOLCALL",
          "value": "position"
        },
        {
          "label": "position-unavailable — cover position without a position tool → CLARIFY",
          "value": "position-unavailable"
        },
        {
          "label": "invalid-position — absolute position outside 0-100 → CLARIFY",
          "value": "invalid-position"
        },
        {
          "label": "relative-position — relative cover change → PASS",
          "value": "relative-position"
        },
        {
          "label": "ack — single explicit tool success → ACK",
          "value": "ack"
        },
        {
          "label": "english — English command with the English strategy → TOOLCALL",
          "value": "english"
        },
        {
          "label": "catalog-unavailable — no HA overview in messages → PASS",
          "value": "catalog-unavailable"
        }
      ]
    },
    {
      "id": "haScenario",
      "type": "pickString",
      "description": "HA loop scenario",
      "options": [
        {
          "label": "router-toolcall — router tool call -> HA -> ACK",
          "value": "router-toolcall"
        },
        {
          "label": "router-cover — router position tool call -> HA -> ACK",
          "value": "router-cover"
        },
        {
          "label": "router-clarify — local clarification, no tool",
          "value": "router-clarify"
        },
        {
          "label": "fallback-text — router passes -> fake LLM text",
          "value": "fallback-text"
        },
        {
          "label": "fallback-toolcall — router passes -> fake LLM tool call",
          "value": "fallback-toolcall"
        },
        {
          "label": "tool-error — tool fails -> LLM explains",
          "value": "tool-error"
        }
      ]
    }
  ]
}
