# Domuno configuration.
# Copy to .env, set the paths, then: chmod 600 .env
# Polish is the default. Keep credentials in .env, not in this template.

# --- Required paths ---------------------------------------------------------
# Path to the Qwen2.5-3B-Instruct Q4_0 GGUF file, as reported by `geniex pull`.
# The default setup uses GGUF and TOKENIZER for the local prompt counter.
GGUF=""
# Directory containing the local tokenizer.json matching this GGUF.
# Leave empty to use the bundled Qwen recipe (assets/qwen-tokenizer).
TOKENIZER=""
# For a gateway-only setup with an existing counter, leave GGUF and TOKENIZER empty:
# COUNTER_URL="http://127.0.0.1:18193/count"
# Host directory with QAIRT 2.50 HTP libraries, including libQnnHtp.so.
# Required when STT_PROVIDER=whisper-qnn.
QNN_LIB_DIR=""
# Optional when `geniex` is already on PATH.
# GENIEX_BIN="/home/arduino/.local/bin/geniex"

# --- Model and prompt routing ----------------------------------------------
# Model context size in tokens.
NCTX=10240
# Language for the router and local speech: pl (Polish), en (English), es (Spanish).
# Select the same language in Home Assistant Assist.
AGENT_LANGUAGE=pl
# 1 lets the rule router answer simple on/off/cover commands without the LLM.
DECIDE_APPLY=1
# concise adds one short-answer instruction; original sends the HA prompt as-is.
RESPONSE_STYLE=concise
# reuse keeps GenieX KV prefixes. reset is only for legacy GenieX 0.9.3.
CACHE_POLICY=reuse

# --- Speech stack -----------------------------------------------------------
# ./run.sh prepare downloads assets for the selected local speech providers.
# whisper-qnn runs Whisper locally; external uses a separate STT service in Assist.
STT_PROVIDER=whisper-qnn
# Optional static local Whisper decoder prompt. Leave empty for no prompt.
STT_PROMPT=""
# pocket runs Pocket TTS locally; external uses a separate TTS service in Assist.
TTS_PROVIDER=pocket

# --- Audio and Linux Voice Assistant ---------------------------------------
# Output of `id -u` and `id -g` on the board.
LVA_USER_ID=1000
LVA_USER_GROUP=1000
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=pulse
# 1 enables LVA's thinking sound at startup. 0 leaves the HA preference unchanged.
ENABLE_THINKING_SOUND=0
# Audio file inside the LVA container; empty uses LVA's bundled processing sound.
PROCESSING_SOUND=""
# Set to 1 temporarily to list audio devices instead of starting LVA normally.
LIST_DEVICES=""

# --- Optional audible cue before a real LLM request ------------------------
# Router actions, ACKs and clarifications stay silent. 0 disables the feature.
LLM_WAIT_SOUND=0
# lva follows LVA's output volume/mute; 0-100 uses a fixed PulseAudio level.
LLM_WAIT_SOUND_VOLUME=lva
LVA_VOLUME_URL=ws://127.0.0.1:6055
# Empty generates a bundled 180 ms cue; otherwise use an absolute host WAV path.
LLM_WAIT_SOUND_FILE=""

# --- Optional information tools (disabled when empty) ----------------------
BRAVE_SEARCH_API_KEY=""
# Warsaw city-centre preset. Clear both coordinates to disable weather.
WEATHER_LATITUDE=52.2297
WEATHER_LONGITUDE=21.0122
WEATHER_LOCATION="Warszawa"
# Optional absolute host WAV played once when a web search starts.
SEARCH_CUE_FILE=""

# --- Private diagnostics ----------------------------------------------------
# 1 records the last user utterance for requests sent to the LLM. Keep logs private.
ROUTER_MISS_LOGGING=0
# Optional ISO 8601 deadline for router miss logging, with an explicit timezone.
ROUTER_MISS_UNTIL=""
# Optional absolute path to replacement command synonyms and replies for the selected language.
ROUTER_VOCABULARY=""
# Metadata-only cache audit. Set to 0 to stop writing it.
CONTEXT_AUDIT=1
# Full normalized requests contain private home data. Explicit opt-in only.
CONTEXT_CAPTURE=0
CONTEXT_CAPTURE_LIMIT=5

# --- Gateway access ---------------------------------------------------------
# Optional bearer token. Empty disables authentication; use only on a trusted LAN.
# Do not expose the gateway to the Internet, even with a token.
GATEWAY_API_KEY=""

# --- Metrics labels ---------------------------------------------------------
# Operator-supplied labels. Set the version after `geniex --skip-update --version`.
METRICS_BACKEND_VERSION=0.11.0
METRICS_PROFILE=baseline
