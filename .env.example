# Domuno configuration.
# Copy to .env, set the paths, then: chmod 600 .env
# The defaults below are the tested Polish profile. Nothing here is a secret.

# --- Required paths ---------------------------------------------------------
# Path to the Qwen2.5-3B-Instruct Q4_0 GGUF file, as reported by `geniex pull`.
# The gateway always needs a prompt counter, built from GGUF + TOKENIZER.
GGUF=""
# For an existing external counter, leave GGUF/TOKENIZER empty and use:
# COUNTER_URL="http://127.0.0.1:18193/count"
# Host directory with QAIRT 2.50 HTP libraries, including libQnnHtp.so.
# Required when STT_PROVIDER=whisper-qnn.
QNN_LIB_DIR=""
# Optional when `geniex` is already on PATH.
# GENIEX_BIN="/home/arduino/.local/bin/geniex"

# --- Model and prompt routing ----------------------------------------------
# 10240 matches the tested HA context.
NCTX=10240
# Router language: pl or en. Local speech below is Polish-only.
AGENT_LANGUAGE=pl
# 1 lets the rule router answer simple on/off/cover commands without the LLM.
DECIDE_APPLY=1
# concise adds one short-answer instruction; original sends the HA prompt as-is.
RESPONSE_STYLE=concise
# reuse keeps GenieX KV prefixes. reset is only for legacy GenieX 0.9.3.
CACHE_POLICY=reuse

# --- Speech stack -----------------------------------------------------------
# whisper-qnn or external. Local Whisper is Polish-only.
STT_PROVIDER=whisper-qnn
# Optional static Polish prompt for the local Whisper decoder. Empty uses the
# built-in command/room vocabulary. Set a custom sentence list to override it.
STT_PROMPT=""
# pocket-pl or external. Local Pocket TTS is Polish-only.
TTS_PROVIDER=pocket-pl

# --- Audio and Linux Voice Assistant ---------------------------------------
# Output of `id -u` and `id -g` on the board.
LVA_USER_ID=1000
LVA_USER_GROUP=1000
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=pulse
# 1 enables LVA's thinking sound at startup. 0 leaves the HA preference unchanged.
ENABLE_THINKING_SOUND=0
# Audio file inside the LVA container; empty uses LVA's bundled processing sound.
PROCESSING_SOUND=""
# Set to 1 temporarily to list audio devices instead of starting LVA normally.
LIST_DEVICES=""

# --- Optional audible cue before a real LLM request ------------------------
# Router actions, ACKs and clarifications stay silent. 0 disables the feature.
LLM_WAIT_SOUND=0
# lva follows LVA's output volume/mute; 0-100 uses a fixed PulseAudio level.
LLM_WAIT_SOUND_VOLUME=lva
LVA_VOLUME_URL=ws://127.0.0.1:6055
# Empty generates a bundled 180 ms cue; otherwise use an absolute host WAV path.
LLM_WAIT_SOUND_FILE=""

# --- Private diagnostics ----------------------------------------------------
# Router miss transcripts and full request captures are off by default.
# The cache audit is metadata-only and on by default; set CONTEXT_AUDIT=0 to stop it.
# ROUTER_MISS_LOGGING=1 records the last user utterance for requests sent to the LLM.
# Never publish these logs. Restart only qwen-ha-gateway.service after a change.
ROUTER_MISS_LOGGING=0
# Optional fixed ISO 8601 cutoff with timezone; empty means until switched off.
ROUTER_MISS_UNTIL=""
# Complete replacement for router_pl.json/router_en.json, as an absolute path.
ROUTER_VOCABULARY=""
# Metadata-only cache audit. Set to 0 to stop writing it.
CONTEXT_AUDIT=1
# Full normalized requests contain private home data. Explicit opt-in only.
CONTEXT_CAPTURE=0
CONTEXT_CAPTURE_LIMIT=5

# --- Gateway access ---------------------------------------------------------
# Optional bearer token. Leave blank on a trusted LAN; never expose to the Internet.
QWEN_GATEWAY_API_KEY=""

# --- Metrics labels ---------------------------------------------------------
# Operator-supplied labels. Set the version after `geniex --skip-update --version`.
METRICS_BACKEND_VERSION=0.11.0
METRICS_PROFILE=baseline
