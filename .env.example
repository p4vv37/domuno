# Copy to .env and edit on the Arduino. This file contains no credentials.
# Set GGUF to the local Q4_0 file shown by `geniex pull`.
GGUF=""
# Must contain QAIRT 2.50 HTP libraries, including libQnnHtp.so.
QNN_LIB_DIR=""
# Normally detected automatically. Override if your install differs.
# GENIEX_BIN="/absolute/path/to/geniex"
NCTX=10240
DECIDE_APPLY=1

# Audio: obtain IDs with `id -u` and `id -g`.
LVA_USER_ID=1000
LVA_USER_GROUP=1000
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=pulse
# Set to 1 temporarily to list audio devices instead of normal LVA startup.
LIST_DEVICES=""
# Optional: set the same key in HA. Leave blank for trusted LAN only.
QWEN_GATEWAY_API_KEY=""
